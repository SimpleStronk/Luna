# macOS junk
.DS_Store

# Backup files
*.bak
*.orig

# === Optional: if you use MGCB Editor ===
# If you want other devs to build content from .mgcb instead of .xnb files
# Then DO include .mgcb and source assets, but ignore compiled .xnb
# (That’s what we did above.)

# === NuGet packages ===
*.nupkg
*.snupkg
packages/
*.nuspec
project.lock.json
project.fragment.lock.json

# === Resharper ===
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# === VS Code ===
.vscode/

