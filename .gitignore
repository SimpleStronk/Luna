# === Visual Studio general ===
.vs/
*.user
*.suo
*.userosscache
*.userprefs
.vs/*

# Build output
bin/
obj/
[Bb]uild/
[Ll]ogs/

# Auto-generated files
*.aps
*.ncb
*.opendb
*.VC.db
*.VC.VC.opendb

# MonoGame content cache (binary outputs)
**/Content/bin/
**/Content/obj/

# MGCB intermediate / output files
*.mgcb.tmp
*.xnb

# Rider / JetBrains
.idea/
*.sln.iml

# System / OS junk
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
